{
  "name": "openspec-studio",
  "displayName": "OpenSpec Studio",
  "description": "Interactive dashboard and multi-AI workflow studio for OpenSpec in VS Code",
  "version": "0.1.0",
  "publisher": "openspec",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/marc2016/OpenSpec-Studio"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other",
    "Programming Languages",
    "Machine Learning"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onCommand:openspec-studio.openDashboard",
    "onView:openspec-studio.specsTree",
    "onCustomEditor:openspec.markdownEditor"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "openspec-studio.openDashboard",
        "title": "Open Studio Dashboard",
        "category": "OpenSpec",
        "icon": "$(dashboard)"
      },
      {
        "command": "openspec-studio.refresh",
        "title": "Refresh OpenSpec State",
        "category": "OpenSpec",
        "icon": "$(refresh)"
      },
      {
        "command": "openspec-studio.openInCustomEditor",
        "title": "Open in OpenSpec Markdown Editor",
        "category": "OpenSpec",
        "icon": "$(edit)"
      }
    ],
    "customEditors": [
      {
        "viewType": "openspec.markdownEditor",
        "displayName": "OpenSpec Markdown Editor",
        "selector": [
          {
            "filenamePattern": "**/openspec/**/*.md"
          },
          {
            "filenamePattern": "**/openspec/*.md"
          },
          {
            "filenamePattern": "openspec/**/*.md"
          },
          {
            "filenamePattern": "openspec/*.md"
          }
        ],
        "priority": "option"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "openspec-studio.openInCustomEditor",
          "when": "resourceExtname == .md",
          "group": "navigation"
        }
      ],
      "explorer/context": [
        {
          "command": "openspec-studio.openInCustomEditor",
          "when": "resourceExtname == .md",
          "group": "navigation"
        }
      ],
      "view/title": [
        {
          "command": "openspec-studio.refresh",
          "when": "view == openspec-studio.specsTree",
          "group": "navigation@1"
        },
        {
          "command": "openspec-studio.openDashboard",
          "when": "view == openspec-studio.specsTree",
          "group": "navigation@2"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "openspec-studio",
          "title": "OpenSpec Studio",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "openspec-studio": [
        {
          "id": "openspec-studio.specsTree",
          "name": "OpenSpec Explorer"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "openspec-studio.specsTree",
        "contents": "No OpenSpec project detected in this workspace.\n[Open Studio Dashboard](command:openspec-studio.openDashboard)"
      }
    ],
    "configuration": {
      "title": "OpenSpec Studio",
      "properties": {
        "openspec.aiTarget": {
          "type": "string",
          "enum": [
            "copilot",
            "terminal",
            "clipboard"
          ],
          "default": "copilot",
          "description": "Target assistant for OpenSpec workflow actions"
        },
        "openspec.cliMode": {
          "type": "string",
          "enum": [
            "auto",
            "local",
            "global",
            "npx"
          ],
          "default": "auto",
          "description": "CLI resolution mode for OpenSpec execution"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile && npm run build:webview",
    "compile:ext": "esbuild ./src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --format=cjs --platform=node --sourcemap",
    "compile": "tsc -p ./tsconfig.json --noEmit && npm run compile:ext",
    "build:webview": "vite build",
    "build": "npm run compile && npm run build:webview",
    "package": "vsce package --no-git-tag-version",
    "test": "vitest run --config vitest.config.ts"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/react": "^18.2.48",
    "@types/react-dom": "^18.2.18",
    "@types/vscode": "^1.85.0",
    "@vitejs/plugin-react": "^4.2.1",
    "@vscode/vsce": "^4.0.0",
    "autoprefixer": "^10.4.17",
    "esbuild": "^0.20.0",
    "postcss": "^8.4.33",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.3.3",
    "vite": "^5.0.12",
    "vitest": "^1.2.1"
  },
  "dependencies": {
    "@mdi/js": "^7.4.47",
    "@mdi/react": "^1.6.1",
    "@mdxeditor/editor": "^4.2.5",
    "clsx": "^2.1.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tailwind-merge": "^2.2.1"
  }
}
